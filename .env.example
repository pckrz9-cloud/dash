# --- Database -------------------------------------------------------------
# SQLite by default (zero setup). For production you can move to Postgres by
# changing the provider in prisma/schema.prisma and pointing this at your DB.
DATABASE_URL="file:./dev.db"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-a-random-string"
# The public URL of the dashboard (http://localhost:3000 in development)
NEXTAUTH_URL="http://localhost:3000"

# --- Encryption -----------------------------------------------------------
# Used to encrypt client API keys at rest. Generate with: openssl rand -hex 32
# If unset, a key is derived from NEXTAUTH_SECRET.
ENCRYPTION_KEY=""

# --- Initial admin account (used by `npm run db:seed`) ---------------------
ADMIN_EMAIL="you@youragency.com"
ADMIN_PASSWORD="change-me-strong-password"
ADMIN_NAME="Agency Admin"

# --- Scheduled sync -------------------------------------------------------
# Secret for the /api/cron/sync endpoint (call it from Vercel Cron / any
# scheduler every 15-30 min to refresh all clients in the background).
CRON_SECRET="change-me-random-string"
